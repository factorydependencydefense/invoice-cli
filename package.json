{
  "name": "invoice-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Command line tool that turns usage records into invoice batches.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "invoice": "bin/invoice.js"
  },
  "scripts": {
    "build": "esbuild bin/invoice.js --bundle --platform=node --packages=external --outfile=dist/invoice.js",
    "test": "node --test \"test/*.test.js\"",
    "test:security": "node --test \"test/security/**/*.test.js\""
  },
  "dependencies": {
    "commander": "15.0.0",
    "lodash": "4.17.10"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
